# Copy this file to .env and fill in your own real values.
# Never commit the actual .env file — it's already in .gitignore.

# PostgreSQL connection string (e.g. from Neon: https://neon.tech)
# Get this from your Neon project's "Connection Details" panel — make sure
# the database name matches the one shown there, not your project's display name.

DATABASE_URL=postgresql://user:password@your-neon-host/dbname?sslmode=require

# Brevo transactional email API key
# Get this from: Brevo dashboard → Settings → SMTP & API → "API keys & MCP" tab
# (NOT the "SMTP" tab — that gives a different kind of key, starting with
# xsmtpsib-, which will NOT work here. This one must start with xkeysib-.)

BREVO_API_KEY=xkeysib-your-real-key-here
